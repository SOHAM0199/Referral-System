# Copy this file to .env and fill in real values before running in production.

# Port the server listens on (Render/Railway/etc. set this automatically)
PORT=3000

# Secret used to sign login sessions — set a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Optional: override where the SQLite file is written
# DB_PATH=./data/referral-portal.db

NODE_ENV=production
